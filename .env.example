# Copy to `.env.local` and fill in. P0 ships with mock mode on and no external
# hosts, so the defaults below are already the working configuration.

# Public origin used for canonical URLs, hreflang and the sitemap (T24/T25).
# Empty = http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Base URL of the real backend (empty = never called, mock mode stays on).
NEXT_PUBLIC_API_BASE=

# 1 = read `mocks/` through `lib/api/client.ts`; 0 = POST to NEXT_PUBLIC_API_BASE.
NEXT_PUBLIC_USE_MOCK=1

# Base URL for game artwork. Empty = render the built-in gradient placeholder
# and load no external images at all.
NEXT_PUBLIC_IMG_BASE=

# Sentry DSN (T75). Empty = reporting is off: the SDK is never imported and no
# request is made to Sentry. Set a real DSN to turn error reporting on.
NEXT_PUBLIC_SENTRY_DSN=

# Share of errors sent, 0..1. Empty or unreadable = 1 (send every error).
NEXT_PUBLIC_SENTRY_SAMPLE_RATE=

# Share of traces sent, 0..1. Empty or unreadable = 0 (off): this mock-era site
# has no spans worth paying for.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

# Signs the mock member session cookie. Required in production; set a long random value.
SESSION_SECRET=
