# Copy to `.env.local` and fill in. P0 ships with mock mode on and no external
# hosts, so the defaults below are already the working configuration.

# Base URL of the real backend (empty = never called, mock mode stays on).
NEXT_PUBLIC_API_BASE=

# 1 = read `mocks/` through `lib/api/client.ts`; 0 = POST to NEXT_PUBLIC_API_BASE.
NEXT_PUBLIC_USE_MOCK=1

# Base URL for game artwork. Empty = render the built-in gradient placeholder
# and load no external images at all.
NEXT_PUBLIC_IMG_BASE=
